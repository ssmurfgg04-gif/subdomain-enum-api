          "domain",
          "status",
          "message"
        ],
        "title": "ScanCreateResponse"
      },
      "ScanRequest": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "tools": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tools"
          },
          "threads": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threads",
            "default": 10
          },
          "retries": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retries",
            "default": 3
          },
          "timeout": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timeout",
            "default": 30
          },
          "rate_limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rate Limit",
            "default": 100
          },
          "format": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Format",
            "default": "json"
          },
          "options": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Options"
          }
        },
        "type": "object",
        "required": [
          "domain"
        ],
        "title": "ScanRequest"
      },
      "ScanStatusResponse": {
        "properties": {
          "scan_id": {
            "type": "string",
            "title": "Scan Id"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "progress": {
            "type": "integer",
            "title": "Progress"
          },
          "total_tools": {
            "type": "integer",
            "title": "Total Tools"
          },
          "completed_tools": {
            "type": "integer",
            "title": "Completed Tools"
          },
          "results": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Results"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "scan_id",
          "domain",
          "status",
          "progress",
          "total_tools",
          "completed_tools"
        ],
        "title": "ScanStatusResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-rapidapi-key",
        "description": "RapidAPI key or direct API key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Direct API key via Bearer token"
      }
    }
  },
  "servers": [
    {
      "url": "https://subdomain-enum-api.onrender.com",
      "description": "Direct Render"
    },
    {
      "url": "https://subdomain-enumeration-api.p.rapidapi.com",
      "description": "RapidAPI Gateway"
    }
  ],
  "security": [
