  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "uptime": {
            "type": "string",
            "title": "Uptime"
          },
          "engine": {
            "type": "string",
            "title": "Engine"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "uptime",
          "engine"
        ],
        "title": "HealthResponse"
      },
      "ScanCreateResponse": {
        "properties": {
          "scan_id": {
            "type": "string",
